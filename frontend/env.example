# Configurações do Frontend - Veritas Fact Checker
# Copie este arquivo para .env.local e ajuste conforme necessário

# Porta do servidor de desenvolvimento
PORT=3001

# URL do Backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# API Keys (opcional - podem ser configuradas no código também)
# NEXT_PUBLIC_GEMINI_API_KEY=sua-chave-gemini-aqui
# NEXT_PUBLIC_TAVILY_API_KEY=sua-chave-tavily-aqui

# Configurações de Debug (opcional)
# NEXT_PUBLIC_DEBUG_MODE=true
# NEXT_PUBLIC_LOG_LEVEL=debug

