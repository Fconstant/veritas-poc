{
  "name": "@veritas/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for Veritas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "build:if-needed": "node ./scripts/ensure-build.mjs",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
